{
  "name": "kafka-message-scheduler-admin-front",
  "root": "client",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vite --port=3000",
        "cwd": "client"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc -b && pnpm exec vite build",
        "cwd": "client"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run",
        "cwd": "client"
      }
    },
    "ci:test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "JEST_JUNIT_OUTPUT_NAME=junit-kafka-message-scheduler-admin-front.xml pnpm exec vitest run --coverage --reporter=default --reporter=junit",
        "cwd": "client"
      }
    },
    "ci:sonar": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --coverage && pnpm exec sonar-scanner",
        "cwd": "client"
      }
    }
  }
}

